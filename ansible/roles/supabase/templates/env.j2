############
# Secrets
#
# YOU MUST CHANGE ALL THE DEFAULT VALUES BELOW BEFORE STARTING THE STACK.
# Never commit a real .env - see README.md "Secrets" for how these are
# generated and supplied via Ansible Vault in this repo.
############

# Postgres
POSTGRES_PASSWORD={{ supabase_postgres_password }}

# Legacy symmetric HS256 key used to sign/verify ANON_KEY and SERVICE_ROLE_KEY.
JWT_SECRET={{ supabase_jwt_secret }}
ANON_KEY={{ supabase_anon_key }}
SERVICE_ROLE_KEY={{ supabase_service_role_key }}

# Newer opaque API keys / asymmetric (ES256) key pair. Left empty: the stack
# runs in legacy-only (HS256) mode without them, see README.md.
SUPABASE_PUBLISHABLE_KEY={{ supabase_supabase_publishable_key }}
SUPABASE_SECRET_KEY={{ supabase_supabase_secret_key }}
JWT_KEYS={{ supabase_jwt_keys }}
JWT_JWKS={{ supabase_jwt_jwks }}
ANON_KEY_ASYMMETRIC={{ supabase_anon_key_asymmetric }}
SERVICE_ROLE_KEY_ASYMMETRIC={{ supabase_service_role_key_asymmetric }}

# Studio dashboard login (HTTP basic auth, enforced by Kong)
DASHBOARD_USERNAME={{ supabase_dashboard_username }}
DASHBOARD_PASSWORD={{ supabase_dashboard_password }}

# Realtime/Supavisor inter-service auth (>= 64 chars)
SECRET_KEY_BASE={{ supabase_secret_key_base }}

# Realtime field-level encryption key (exactly 16 chars)
REALTIME_DB_ENC_KEY={{ supabase_realtime_db_enc_key }}

# Supavisor's encrypted configuration storage key (exactly 32 chars)
VAULT_ENC_KEY={{ supabase_vault_enc_key }}

# Studio <-> postgres-meta connection string encryption key (>= 32 chars)
PG_META_CRYPTO_KEY={{ supabase_pg_meta_crypto_key }}

# Logflare/Vector log ingestion tokens (>= 32 chars each)
LOGFLARE_PUBLIC_ACCESS_TOKEN={{ supabase_logflare_public_access_token }}
LOGFLARE_PRIVATE_ACCESS_TOKEN={{ supabase_logflare_private_access_token }}

# Storage's S3-compatible protocol endpoint credentials
S3_PROTOCOL_ACCESS_KEY_ID={{ supabase_s3_protocol_access_key_id }}
S3_PROTOCOL_ACCESS_KEY_SECRET={{ supabase_s3_protocol_access_key_secret }}


############
# URLs
############

# Reachable at https://supabase.home.arpa via Traefik; Kong itself listens
# on plain HTTP (TLS is terminated by Traefik).
SUPABASE_PUBLIC_URL={{ supabase_supabase_public_url }}
API_EXTERNAL_URL={{ supabase_api_external_url }}
SITE_URL={{ supabase_site_url }}
ADDITIONAL_REDIRECT_URLS={{ supabase_additional_redirect_urls }}


############
# Database
############

POSTGRES_HOST={{ supabase_postgres_host }}
POSTGRES_DB={{ supabase_postgres_db }}
POSTGRES_PORT={{ supabase_postgres_port }}


############
# Supavisor (connection pooler) - published on the LXC for other homelab
# services to connect directly, see README.md "Networking"
############

POOLER_PROXY_PORT_TRANSACTION={{ supabase_pooler_proxy_port_transaction }}
POOLER_DEFAULT_POOL_SIZE={{ supabase_pooler_default_pool_size }}
POOLER_MAX_CLIENT_CONN={{ supabase_pooler_max_client_conn }}
POOLER_TENANT_ID={{ supabase_pooler_tenant_id }}
POOLER_DB_POOL_SIZE={{ supabase_pooler_db_pool_size }}


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION={{ supabase_studio_default_organization }}
STUDIO_DEFAULT_PROJECT={{ supabase_studio_default_project }}
# Optional, enables the Studio AI Assistant. Leave empty to disable.
OPENAI_API_KEY={{ supabase_openai_api_key }}


############
# Auth (GoTrue)
############

JWT_EXPIRY={{ supabase_jwt_expiry }}
DISABLE_SIGNUP={{ supabase_disable_signup }}

MAILER_URLPATHS_CONFIRMATION={{ supabase_mailer_urlpaths_confirmation }}
MAILER_URLPATHS_INVITE={{ supabase_mailer_urlpaths_invite }}
MAILER_URLPATHS_RECOVERY={{ supabase_mailer_urlpaths_recovery }}
MAILER_URLPATHS_EMAIL_CHANGE={{ supabase_mailer_urlpaths_email_change }}

ENABLE_EMAIL_SIGNUP={{ supabase_enable_email_signup }}
# No SMTP provider configured yet (internal-only deployment) - email
# confirmation is disabled so signups aren't blocked waiting on mail that
# will never arrive. Flip to false once SMTP_* below point at a real relay.
ENABLE_EMAIL_AUTOCONFIRM={{ supabase_enable_email_autoconfirm }}
SMTP_ADMIN_EMAIL={{ supabase_smtp_admin_email }}
SMTP_HOST={{ supabase_smtp_host }}
SMTP_PORT={{ supabase_smtp_port }}
SMTP_USER={{ supabase_smtp_user }}
SMTP_PASS={{ supabase_smtp_pass }}
SMTP_SENDER_NAME={{ supabase_smtp_sender_name }}
ENABLE_ANONYMOUS_USERS={{ supabase_enable_anonymous_users }}

ENABLE_PHONE_SIGNUP={{ supabase_enable_phone_signup }}
ENABLE_PHONE_AUTOCONFIRM={{ supabase_enable_phone_autoconfirm }}


############
# Storage
############

# Directory name under /var/lib/storage (bind-mounted from the NAS) used as
# the root for the 'file' storage backend.
GLOBAL_S3_BUCKET={{ supabase_global_s3_bucket }}
REGION={{ supabase_region }}
STORAGE_TENANT_ID={{ supabase_storage_tenant_id }}


############
# Functions (Edge Functions)
############

FUNCTIONS_VERIFY_JWT={{ supabase_functions_verify_jwt }}


############
# API (PostgREST)
############

PGRST_DB_SCHEMAS={{ supabase_pgrst_db_schemas }}
PGRST_DB_MAX_ROWS={{ supabase_pgrst_db_max_rows }}
PGRST_DB_EXTRA_SEARCH_PATH={{ supabase_pgrst_db_extra_search_path }}


############
# Logs and Analytics (Logflare + Vector)
############

DOCKER_SOCKET_LOCATION={{ supabase_docker_socket_location }}


############
# API gateway (Kong)
############

KONG_HTTP_PORT={{ supabase_kong_http_port }}


############
# imgproxy
############

IMGPROXY_AUTO_WEBP={{ supabase_imgproxy_auto_webp }}
