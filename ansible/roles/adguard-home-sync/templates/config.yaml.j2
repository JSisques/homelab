origin:
  url: "http://{{ hostvars['adguard-home-1']['ansible_host'] }}:3000"
  username: "{{ adguard_sync_origin_username }}"
  password: "{{ adguard_sync_origin_password }}"

replicas:
  - url: "http://{{ ansible_host }}:3000"
    username: "{{ adguard_sync_replica_username }}"
    password: "{{ adguard_sync_replica_password }}"

cron: "{{ adguard_sync_cron }}"

api:
  port: {{ adguard_sync_api_port }}
