# Secrets consumed by `make deploy`/`make deploy-<service>` via
# ANSIBLE_EXTRA_VARS (see Makefile). Copy this file to `.env` (already
# gitignored, never commit the real one) and fill in what you need -- only
# the services you're deploying that require them. `.env` is loaded
# automatically by `make deploy`/`make deploy-<service>` if it exists;
# nothing changes if you keep exporting these by hand instead.
#
# Unset/empty is safe for every one of these: some roles deploy anyway with
# an insecure default (n8n), others refuse to run (cookidoo-mcp,
# cloudflared), others deploy fine but silently drop the feature that needs
# the secret (Alertmanager's Telegram receiver). See each service's page
# under website/src/content/docs/servicios/ for which case applies.

# n8n -- Postgres password. Deploys with "changeme" if unset.
N8N_POSTGRES_PASSWORD=

# Cookidoo MCP -- required, the role refuses to run without both.
COOKIDOO_MCP_EMAIL=
COOKIDOO_MCP_PASSWORD=

# Cloudflared -- required, the role refuses to run without it.
# The JSON credentials file content from `cloudflared tunnel create`, as a
# single-line string.
CLOUDFLARED_CREDS_JSON=

# Monitoring -- Alertmanager's Telegram receiver. Alerts fire into a null
# receiver if unset (deploy still succeeds).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Downloads stack -- gluetun VPN. Required for the tunnel to come up.
DOWNLOADS_VPN_SERVICE_PROVIDER=
DOWNLOADS_VPN_WIREGUARD_PRIVATE_KEY=
DOWNLOADS_VPN_WIREGUARD_ADDRESSES=

# RustFS -- S3-compatible storage credentials.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# AdGuard Home Sync -- admin credentials of both instances, created by hand
# in each one's first-boot wizard (see servicios/redes.md#adguard-home).
ADGUARD_SYNC_ORIGIN_USERNAME=
ADGUARD_SYNC_ORIGIN_PASSWORD=
ADGUARD_SYNC_REPLICA_USERNAME=
ADGUARD_SYNC_REPLICA_PASSWORD=

# Terraform (Proxmox) -- endpoint + API token for `make init`/`plan`/`apply`/
# `destroy`. Also sidesteps the zsh "!" history-expansion gotcha (see
# desplegar.mdx): sourced from a file, never typed at the interactive
# prompt, so the "!" in the token is never touched.
TF_VAR_proxmox_endpoint=
TF_VAR_proxmox_api_token=
