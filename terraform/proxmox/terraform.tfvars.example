# proxmox_endpoint and proxmox_api_token are intentionally left out of this
# example file. They are provided via TF_VAR_proxmox_endpoint /
# TF_VAR_proxmox_api_token (see .github/workflows/terraform.yaml and
# deploy.yaml), or a local terraform.tfvars that is never committed.

proxmox_node    = "pve"
lxc_storage     = "local-lvm"
vm_storage      = "local-lvm"
network_bridge  = "vmbr0"
gateway         = "192.168.1.1"
ssh_public_key  = "ssh-ed25519 AAAA... user@host"
debian_template = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"
vm_user         = "ansible"

# VM ID of a cloud-init-ready template (Debian/Ubuntu cloud image, converted
# to a Proxmox template once) that every managed VM is cloned from. Create it
# manually — Terraform only clones existing templates, it doesn't build them.
vm_template_id = 9000

# lxc_network and vm_nodes are NOT set here. They are generated from
# config/hosts.yaml (the single source of truth for host addresses and
# resource sizing) by scripts/generation/generate-terraform-vars.sh, which
# writes terraform/proxmox/hosts.auto.tfvars.json. Terraform loads that
# file automatically (the *.auto.tfvars.json naming convention) — no
# -var-file flag needed, and no need to duplicate IPs/sizing here.
#
# To add or resize an LXC/VM, edit config/hosts.yaml and re-run:
#   ./scripts/generation/generate-terraform-vars.sh
