# proxmox_endpoint and proxmox_api_token are intentionally left out of this
# example file. They are provided via TF_VAR_proxmox_endpoint /
# TF_VAR_proxmox_api_token (see .github/workflows/terraform.yaml and
# deploy.yaml), or a local terraform.tfvars that is never committed.

proxmox_node    = "pve"
lxc_storage     = "local-lvm"
vm_storage      = "local-lvm"
network_bridge  = "vmbr0"
gateway         = "192.168.1.1"
ssh_public_key  = "ssh-ed25519 AAAA... user@host"
debian_template = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"
vm_user         = "ansible"

lxc_network = {
  monitoring = {
    ip     = "192.168.1.20"
    cores  = 4
    memory = 4096
    disk   = 32
  }

  homepage = {
    ip     = "192.168.1.21"
    cores  = 2
    memory = 1024
    disk   = 8
  }

  uptime-kuma = {
    ip     = "192.168.1.22"
    cores  = 2
    memory = 1024
    disk   = 8
  }

  it-tools = {
    ip     = "192.168.1.23"
    cores  = 2
    memory = 1024
    disk   = 8
  }

  n8n = {
    ip     = "192.168.1.24"
    cores  = 2
    memory = 4096
    disk   = 32
  }

  cloudflared = {
    ip     = "192.168.1.25"
    cores  = 1
    memory = 512
    disk   = 8
  }
}

# K3s nodes are not provisioned yet. Uncomment and adjust once the cluster
# is ready to be built.
