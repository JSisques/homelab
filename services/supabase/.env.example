############
# Secrets
#
# YOU MUST CHANGE ALL THE DEFAULT VALUES BELOW BEFORE STARTING THE STACK.
# Never commit a real .env - see README.md "Secrets" for how these are
# generated and supplied via Ansible Vault in this repo.
############

# Postgres
POSTGRES_PASSWORD=changeme

# Legacy symmetric HS256 key used to sign/verify ANON_KEY and SERVICE_ROLE_KEY.
JWT_SECRET=changeme
ANON_KEY=changeme
SERVICE_ROLE_KEY=changeme

# Newer opaque API keys / asymmetric (ES256) key pair. Left empty: the stack
# runs in legacy-only (HS256) mode without them, see README.md.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Studio dashboard login (HTTP basic auth, enforced by Kong)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=changeme

# Realtime/Supavisor inter-service auth (>= 64 chars)
SECRET_KEY_BASE=changeme

# Realtime field-level encryption key (exactly 16 chars)
REALTIME_DB_ENC_KEY=supabaserealtime

# Supavisor's encrypted configuration storage key (exactly 32 chars)
VAULT_ENC_KEY=changeme-32-characters-exactly!

# Studio <-> postgres-meta connection string encryption key (>= 32 chars)
PG_META_CRYPTO_KEY=changeme-32-characters-minimum

# Logflare/Vector log ingestion tokens (>= 32 chars each)
LOGFLARE_PUBLIC_ACCESS_TOKEN=changeme
LOGFLARE_PRIVATE_ACCESS_TOKEN=changeme

# Storage's S3-compatible protocol endpoint credentials
S3_PROTOCOL_ACCESS_KEY_ID=changeme
S3_PROTOCOL_ACCESS_KEY_SECRET=changeme


############
# URLs
############

# Reachable at https://supabase.home.arpa via Traefik; Kong itself listens
# on plain HTTP (TLS is terminated by Traefik).
SUPABASE_PUBLIC_URL=https://supabase.home.arpa
API_EXTERNAL_URL=https://supabase.home.arpa/auth/v1
SITE_URL=https://supabase.home.arpa
ADDITIONAL_REDIRECT_URLS=


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Supavisor (connection pooler) - published on the LXC for other homelab
# services to connect directly, see README.md "Networking"
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=homelab
POOLER_DB_POOL_SIZE=5


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Homelab
STUDIO_DEFAULT_PROJECT=Default Project
# Optional, enables the Studio AI Assistant. Leave empty to disable.
OPENAI_API_KEY=


############
# Auth (GoTrue)
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# No SMTP provider configured yet (internal-only deployment) - email
# confirmation is disabled so signups aren't blocked waiting on mail that
# will never arrive. Flip to false once SMTP_* below point at a real relay.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false


############
# Storage
############

# Directory name under /var/lib/storage (bind-mounted from the NAS) used as
# the root for the 'file' storage backend.
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=homelab


############
# Functions (Edge Functions)
############

FUNCTIONS_VERIFY_JWT=false


############
# API (PostgREST)
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Logs and Analytics (Logflare + Vector)
############

DOCKER_SOCKET_LOCATION=/var/run/docker.sock


############
# API gateway (Kong)
############

KONG_HTTP_PORT=8000


############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true
