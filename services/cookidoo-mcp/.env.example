# ---------------------------------------------------------------------------
# cookidoo-mcp deployment secrets
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Cookidoo account credentials (required). In production these are supplied
# by the cookidoo-mcp Ansible role from Ansible Vault / CI secrets, not this
# file — see ansible/roles/cookidoo-mcp/README.md.
COOKIDOO_EMAIL=your@email.com
COOKIDOO_PASSWORD=your-password
