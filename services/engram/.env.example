ENGRAM_IMAGE_TAG=v2.0.0-rc.8

POSTGRES_DB=engram_cloud
POSTGRES_USER=engram
POSTGRES_PASSWORD=change-me

ENGRAM_DATABASE_URL=postgres://engram:change-me@postgres:5432/engram_cloud?sslmode=disable

# Comma-separated allowlist, or "*" to allow any project name.
ENGRAM_CLOUD_ALLOWED_PROJECTS=*

# Bearer token for /sync/* clients (engram cloud config --server ... + ENGRAM_CLOUD_TOKEN).
ENGRAM_CLOUD_TOKEN=change-me

# Separate token for the /dashboard admin surfaces. Must differ from ENGRAM_CLOUD_TOKEN.
ENGRAM_CLOUD_ADMIN=change-me

# Must be an explicit, non-default 32+ byte secret in authenticated mode.
ENGRAM_JWT_SECRET=change-me
