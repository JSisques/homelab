---
extends: default

ignore: |
  website/node_modules/
  website/pnpm-lock.yaml
  .terraform/
  # Vendored verbatim from supabase/supabase's docker/ self-hosting
  # reference (see services/supabase/README.md "Upstream") and kept
  # close to source on purpose, so future upstream updates diff cleanly
  # instead of drowning in reformatting noise.
  services/supabase/compose.yaml
  services/supabase/volumes/

rules:
  # No file in this repo uses "---" document markers; enforcing it now
  # would mean touching every YAML file for no functional benefit.
  document-start: disable
  # GitHub Actions' `on:` trigger key is YAML 1.1 truthy ("on" == true),
  # which is intentional and appears in every workflow file.
  truthy: disable
  line-length:
    max: 80
